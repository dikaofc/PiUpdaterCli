{
  "lastChangelogVersion": "0.84.2",
  "theme": "terminal-boost-aurora",
  "enableSkillCommands": true,
  "quietStartup": true,
  "defaultThinkingLevel": "low",
  "skills": [
    "~/.pi/skills",
    "~/.pi/agent/skills",
    "~/.claude/skills"
  ],
  "extensions": [
    "~/.pi/agent/extensions"
  ],
  "hideThinkingBlock": false,
  "toolOutputExpanded": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "maxRetries": 6,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 5,
      "maxRetryDelayMs": 60000
    }
  }
}
